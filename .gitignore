# 依赖
node_modules/
.pnpm-store/

# 环境变量 —— 绝对不能提交，里面是真实密钥
.env
.env.local
.env.*.local
!.env.example

# 数据库文件（本地开发数据，不入库）
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# 构建产物
dist/
build/
.vite/
*.tsbuildinfo

# Prisma 生成的客户端代码（由 prisma generate 产出，不入库）
apps/server/src/generated/

# 日志
*.log
npm-debug.log*
yarn-error.log*

# 生成失败时存档的模型原始输出（排查用，不入库）
.debug/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# WorkBuddy 工作区数据
.workbuddy/

# 用户上传的头像等文件（不入库）
apps/server/uploads/
