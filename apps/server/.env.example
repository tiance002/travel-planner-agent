# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会进入版本库。

# ===== 数据库 =====
# 开发期使用本地 SQLite 文件；将来切换 PostgreSQL 时替换为 postgresql:// 连接串
# 相对路径以 apps/server 目录为基准，实际文件位于 apps/server/prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# ===== 服务端口 =====
PORT=3001

# ===== JWT 签名密钥 =====
# 生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 48
JWT_SECRET="请替换为你自己生成的一长串随机字符"

# ===== 用户 API Key 的加密主密钥 =====
# 必须是 32 字节，即 64 位十六进制字符。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：这个密钥一旦丢失，已加密的用户 API Key 将无法解密。
VAULT_MASTER_KEY="请替换为你自己生成的 64 位十六进制字符串"

# ===== 高德开放平台 =====
# 两种 Key 类型不同、用途不同，不要混用。
#
# Web 服务 Key —— 仅后端调用 POI 搜索 / 路径规划 / 天气，绝不下发到前端
# 申请入口：https://lbs.amap.com/ 控制台 → 应用管理 → 添加 Key → Web服务
AMAP_WEB_SERVICE_KEY=""

# Web 端(JS API) Key —— 浏览器加载地图使用，需在控制台配置域名白名单
# 申请入口同上，添加 Key 时选择 Web端(JS API)
AMAP_JS_KEY=""

# JS API 安全密钥 —— 与上面的 JS Key 配套，创建 JS Key 时平台会自动生成
# 2021 年之后新建的 JS Key 都强制要求，缺少它地图会报 INVALID_USER_SCODE
AMAP_JS_SECURITY_CODE=""

# ===== 模型服务（可选，开发期兜底）=====
# 用户在「个人设置」里填了自己的 API Key 时，一律优先用用户自己的；
# 只有用户还没填时，后端才回退到下面这组全局默认值。
# 注意：填了它，所有未配置 Key 的账号都会消耗这个 Key 的余额，生产环境请留空。
DEFAULT_MODEL_PROVIDER="DeepSeek"
DEFAULT_MODEL_BASE_URL="https://api.deepseek.com/v1"
DEFAULT_MODEL_NAME="deepseek-chat"
DEFAULT_MODEL_API_KEY=""
