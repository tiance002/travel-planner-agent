# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会进入版本库。

# ===== 数据库 =====
# 开发期使用本地 SQLite 文件；将来切换 PostgreSQL 时替换为 postgresql:// 连接串
# 相对路径以 apps/server 目录为基准，实际文件位于 apps/server/prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# ===== 服务端口 =====
PORT=3001

# ===== JWT 签名密钥 =====
# 生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 48
JWT_SECRET="请替换为你自己生成的一长串随机字符"

# ===== 用户 API Key 的加密主密钥 =====
# 必须是 32 字节，即 64 位十六进制字符。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：这个密钥一旦丢失，已加密的用户 API Key 将无法解密。
VAULT_MASTER_KEY="请替换为你自己生成的 64 位十六进制字符串"

# ===== 高德开放平台 =====
# 两种 Key 类型不同、用途不同，不要混用。
#
# Web 服务 Key —— 仅后端调用 POI 搜索 / 路径规划 / 天气，绝不下发到前端
# 申请入口：https://lbs.amap.com/ 控制台 → 应用管理 → 添加 Key → Web服务
AMAP_WEB_SERVICE_KEY=""

# Web 端(JS API) Key —— 浏览器加载地图使用，需在控制台配置域名白名单
# 申请入口同上，添加 Key 时选择 Web端(JS API)
AMAP_JS_KEY=""
