// Prisma 数据模型 —— 旅游规划应用
//
// 开发期使用 SQLite。将来切换 PostgreSQL 时：
//   1. 把 datasource 的 provider 改为 "postgresql"
//   2. 用 @db.Uuid / @db.ByteA / @db.JsonB 等注解补上字段类型（SQLite 下不支持这些注解）
//   3. 重新生成迁移
// 因此在写业务代码时，请避免使用 SQLite 专有语法。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 用户账号
model User {
  id String @id @default(uuid())

  /// 登录名，全局唯一
  username String @unique
  /// 密码哈希。使用 Node 内置 scrypt 加盐派生，禁止明文或 MD5
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setting UserSetting?
  trips   Trip[]
}

/// 用户的模型配置与加密后的 API Key，与 User 一对一
model UserSetting {
  userId String @id

  /// 展示用的厂商名称，如 DeepSeek / 通义千问
  provider String @default("")
  /// OpenAI 兼容接口地址，支持用户自定义
  baseUrl String @default("")
  /// 模型名，如 deepseek-chat
  modelName String @default("")

  /// AES-256-GCM 密文
  apiKeyCipher Bytes?
  /// 每条记录独立的随机 IV（12 字节）
  apiKeyIv Bytes?
  /// GCM 认证标签，用于完整性校验
  apiKeyTag Bytes?
  /// 主密钥版本号，为将来轮换密钥预留
  keyVersion Int @default(1)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 行程主表
model Trip {
  id     String @id @default(uuid())
  userId String

  title String

  /// 目的地城市名
  cityName String
  /// 高德行政区划编码，POI 检索必填
  cityAdcode String

  startDate DateTime
  /// 行程天数
  days Int
  /// 团队人数，用于人均分摊与餐厅容量建议
  travelers Int

  /// 旅游偏好多选，存 JSON 数组字符串
  preferences String @default("[]")
  /// 额外需求，存 JSON 数组字符串
  extraNeeds String @default("[]")

  /// 预算数额
  budgetAmount Float?
  /// 预算口径：per_person 人均 / total 总价
  budgetScope String @default("per_person")

  /// 住宿锚点是否已确定。false 时 stay* 字段存 AI 推荐的中心区域
  stayResolved Boolean @default(false)
  stayPoiId    String?
  stayName     String?
  stayLng      Float?
  stayLat      Float?

  /// draft 草稿 / generating 生成中 / ready 完成 / failed 失败
  status String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripDays TripDay[]

  @@index([userId])
}

/// 行程中的每一天
model TripDay {
  id     String @id @default(uuid())
  tripId String

  /// 第几天，从 1 开始
  dayIndex Int
  date     DateTime

  /// 天气数据，存 JSON 字符串。超出预报窗口时为空
  weather String?
  /// 当日一句话概述
  summary String?

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripItem[]

  @@unique([tripId, dayIndex])
}

/// 行程条目：景点或餐厅。打卡状态也记录在这里
model TripItem {
  id        String @id @default(uuid())
  tripDayId String

  /// 当天的顺序，从 1 开始
  orderIndex Int
  /// 时段：morning / noon / afternoon / evening
  slot String
  /// 类型：spot 景点 / restaurant 餐厅
  itemType String

  /// 以下字段全部来自高德 POI 返回值，坐标不允许由模型编造
  poiId   String?
  name    String
  lng     Float?
  lat     Float?
  address String?
  tel     String?

  /// 评分，仅餐饮、酒店、景点、影院类 POI 返回
  rating String?
  /// 人均消费，同上
  cost String?
  /// 特色内容（特色菜），仅美食 POI 返回
  tag String?
  /// 营业时间原文。缺失时前端显示「营业时间未知」
  openTimeText String?
  /// 推荐理由
  note String?

  /// 打卡时间。null 表示未打卡
  checkedAt DateTime?

  tripDay TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
}
